msgstr "Даље"

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1919
msgid "Create employee"
msgstr "Креирај запосленог"

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1920
